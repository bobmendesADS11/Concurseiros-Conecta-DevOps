{
  "name": "concurseiro-conecta-backend",
  "version": "3.0.0",
  "description": "Backend do Concurseiro Conecta",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/*.test.js\"",
    "lint": "eslint src tests prisma",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/unit/*.test.js\" \"tests/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.js\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.4",
    "prisma": "^7.8.0",
    "selenium-webdriver": "^4.52.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
