# Copie este arquivo para .env e ajuste a senha do seu PostgreSQL.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/concurseiro_conecta?schema=public"
PORT=3000
# Qualquer texto longo e secreto. Não use o mesmo do exemplo em produção.
JWT_SECRET=troque-por-um-segredo-local
# Opcional: banco usado pelos testes automatizados (padrão: concurseiro_conecta_test)
# TEST_DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/concurseiro_conecta_test?schema=public"
