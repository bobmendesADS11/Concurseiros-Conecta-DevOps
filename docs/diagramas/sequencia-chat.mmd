sequenceDiagram
  participant FA as Frontend Ana
  participant W as Socket.IO (chat.js)
  participant S as conexaoService
  participant P as PostgreSQL
  participant FB as Frontend Bruno
  FA->>W: conecta com auth.token (JWT)
  W->>W: validarToken (recusa se inválido)
  FA->>W: entrar_conexao {id_conexao}
  W->>S: conexaoAceitaDoUsuario
  S-->>W: ok (participante + status aceita)
  FA->>W: enviar_mensagem {id_conexao, conteudo}
  W->>S: enviarMensagem (valida 1..1000 caracteres, conexão aceita, permitir_mensagens)
  alt válido
    S->>P: INSERT mensagens
    W-->>FA: ack {ok: true, mensagem}
    W-->>FB: receber_mensagem (sala conexao:id)
  else sem conexão aceita / bloqueado
    W-->>FA: ack {ok: false, status: 403}
  end
