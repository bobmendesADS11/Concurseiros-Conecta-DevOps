erDiagram
  usuarios ||--o| preferencias_privacidade : "tem"
  usuarios ||--o{ viagens : "planeja"
  concurso ||--o{ viagens : "destino de"
  bancas ||--o{ concurso : "organiza"
  usuarios ||--o{ candidatos_concurso : "inscrito"
  concurso ||--o{ candidatos_concurso : "tem"
  usuarios ||--o{ conexoes : "solicita"
  usuarios ||--o{ conexoes : "recebe"
  conexoes ||--o{ mensagens : "contém"
  usuarios ||--o{ mensagens : "envia"
  usuarios {
    int id_usuario PK
    char11 cpf UK
    varchar nome
    varchar email UK
    varchar senha "hash bcrypt"
    varchar cidade
    char2 estado
    varchar bio
    varchar foto_url
  }
  preferencias_privacidade {
    int id_preferencia PK
    int id_usuario FK "UNIQUE"
    bool perfil_publico
    bool receber_solicitacoes
    bool permitir_mensagens
  }
  bancas {
    int id_banca PK
    varchar nome UK
  }
  concurso {
    int id_concurso PK
    int id_banca FK
    varchar cargo
    varchar local
    date data
    varchar url_edital
    int qtd_candidatos "trigger"
  }
  candidatos_concurso {
    int id_usuario PK
    int id_concurso PK
  }
  viagens {
    int id_viagem PK
    int id_usuario FK
    int id_concurso FK
    varchar cidade_origem
    date data_ida
    date data_volta "CHECK >= ida"
    varchar status "CHECK planejada|confirmada|cancelada"
    bool conflito_datas
  }
  conexoes {
    int id_conexao PK
    int id_solicitante FK
    int id_destinatario FK
    varchar status "CHECK pendente|aceita|recusada"
    timestamp data_solicitacao
    timestamp data_resposta
  }
  mensagens {
    int id_mensagem PK
    int id_conexao FK
    int id_remetente FK
    varchar conteudo "1..1000"
    timestamp data_envio
  }
