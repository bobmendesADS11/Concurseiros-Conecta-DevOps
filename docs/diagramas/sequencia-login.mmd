sequenceDiagram
  actor U as Concurseiro
  participant F as Frontend (script.js)
  participant A as authController.login
  participant P as Prisma / PostgreSQL
  U->>F: e-mail + senha, clica Entrar
  F->>A: POST /api/auth/login
  A->>P: findUnique(usuarios.email)
  P-->>A: usuário (senha em hash)
  A->>A: bcrypt.compare(senha, hash)
  alt senha correta
    A-->>F: 200 { token JWT, usuario }
    F->>F: guarda token na sessão, abre Socket.IO
    F-->>U: tela Home com as viagens
  else e-mail inexistente ou senha errada
    A-->>F: 401 "E-mail ou senha incorretos."
    F-->>U: mensagem de erro na tela de login
  end
